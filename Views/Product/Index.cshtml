@model IEnumerable<GestionArticles.Models.Product>

@{
    ViewData["Title"] = "Liste des produits";
    bool canManage = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">Liste des produits</h1>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Ajouter un nouveau produit
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center" role="alert">
        Aucun produit disponible.
    </div>
}
else
{
    <div class="card-group d-flex flex-wrap justify-content-start">
        @foreach (var product in Model)
        {
            var photoPath = "~/images/" + (product.Image ?? "noimage.jpg");
            <div class="card m-3 shadow-sm" style="min-width: 18rem; max-width:30.5%;">
                <div class="card-header bg-light">
                    <h5><b>Nom : </b>@product.Name</h5>
                    <h5><b>Prix : </b>@product.Price.ToString("0.00") DT</h5>
                    <h5><b>Quantité : </b>@product.QteStock</h5>
                    <h5><b>Catégorie : </b>@(product.Category != null ? product.Category.CategoryName : "Non spécifiée")</h5>
                </div>
                <img class="card-img-top imageThumbnail" src="@photoPath" asp-append-version="true" alt="@product.Name" />
                <div class="card-footer text-center">
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-primary m-1">
                        <i class="bi bi-eye"></i> Détails
                    </a>
                    <a asp-controller="Panier" asp-action="AddProduct" class="btn btn-outline-secondary" asp-route-id="@product.ProductId">Ajouter Au Panier</a>
                    @if (canManage)
                    {
                        <a asp-action="Edit" asp-controller="Product" class="btn btn-warning m-1" asp-route-id="@product.ProductId">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                        <a asp-action="Delete" asp-controller="Product" class="btn btn-danger m-1" asp-route-id="@product.ProductId">
                            <i class="bi bi-trash"></i> Supprimer
                        </a>
                    }
                </div>
            </div>
        }
    </div>
}

<!-- Pagination -->
@{
    int totalPages = ViewBag.TotalPages ?? 1;
}
@if (totalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= totalPages; i++)
        {
            <a asp-action="Index" asp-route-categoryId="@ViewBag.CategoryId"
               asp-route-page="@i" class="btn btn-secondary m-1">
                @i
            </a>
        }
    </div>
}
