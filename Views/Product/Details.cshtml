@model GestionArticles.Models.Product

@{
    ViewData["Title"] = "Détails du produit";
    // Chemin de l'image (utilise noimage.jpg si aucune image n'est définie)
    var photoPath = "~/images/" + (Model.Image ?? "noimage.jpg");
}

<h1 class="mb-4">Détails du produit</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <dl class="row">

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Price)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Price) DT</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.QteStock)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.QteStock)</dd>

            <dt class="col-sm-4">Catégorie</dt>
            <dd class="col-sm-8">
                @(Model.Category != null ? Model.Category.CategoryName : "Non spécifiée")
            </dd>

            <dt class="col-sm-4">Image</dt>
            <dd class="col-sm-8">
                <img src="@photoPath"
                     asp-append-version="true"
                     height="150"
                     width="150"
                     class="img-thumbnail" />
            </dd>

        </dl>
    </div>
</div>

<div class="mt-3">
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.ProductId" class="btn btn-primary me-2">Modifier</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Retour à la liste</a>
</div>