<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
    if (window.jQuery && $.validator) {
        // Accepter aussi bien la virgule que le point pour les nombres
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
        };
        // Supporter la validation de plage (range) pour les nombres avec virgule ou point
        $.validator.methods.range = function (value, element, param) {
            var val = (value + '').replace(/\s/g, '').replace(',', '.');
            return this.optional(element) || (Number(val) >= param[0] && Number(val) <= param[1]);
        };
    }
</script>
