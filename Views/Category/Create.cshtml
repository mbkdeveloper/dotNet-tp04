@model GestionArticles.Models.Category

@{
    ViewData["Title"] = "Nouvelle catégorie";
}

<h1 class="mb-4">Nouvelle catégorie</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            @* Affiche les messages d'erreur globaux du formulaire *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CategoryName" class="form-label fw-bold"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="submit" value="Créer" class="btn btn-primary me-2" />
                <a asp-action="Index" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
