@model GestionArticles.Models.Category

@{
    ViewData["Title"] = "Détails de la catégorie";
}

<h1 class="mb-4">Détails de la catégorie</h1>

<div class="card col-md-6">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CategoryName)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.CategoryName)</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.CategoryId" class="btn btn-primary me-2">Modifier</a>
    <a asp-action="Index" class="btn btn-secondary">Retour à la liste</a>
</div>
